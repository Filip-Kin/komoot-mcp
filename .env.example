# komoot-mcp environment. Copy to .env and fill in. Never commit .env.

# Public identity (Zoraxy terminates TLS and proxies to 127.0.0.1:PORT)
KOMOOT_MCP_PUBLIC_URL=https://komoot-mcp.filipkin.com
PORT=7692
HOST=127.0.0.1
KOMOOT_MCP_ALLOWED_HOSTS=komoot-mcp.filipkin.com

# Upstream Authelia OIDC — register a confidential client "komootmcp" first.
AUTHELIA_ISSUER=https://auth.filipkin.com
AUTHELIA_CLIENT_ID=komootmcp
AUTHELIA_CLIENT_SECRET=
KOMOOT_MCP_REQUIRED_GROUP=admins

# komoot account (reverse-engineered mobile API). Email + password ONLY.
KOMOOT_EMAIL=
KOMOOT_PASSWORD=
# Default centre for "near me" when no place/coords are given (optional).
KOMOOT_HOME_LAT=
KOMOOT_HOME_LNG=
KOMOOT_HOME_LABEL=home
